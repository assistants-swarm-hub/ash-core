{
  "name": "assistants-swarm-hub",
  "version": "1.49.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "core",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start --workspace @assistants-swarm-hub/core",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "npm run test:watch --workspace @assistants-swarm-hub/core",
    "test:integration": "turbo run test:integration",
    "test:linux": "docker compose -f docker-compose.test.yml run --rm test",
    "db:generate": "npm run db:generate --workspace @assistants-swarm-hub/core",
    "db:migrate": "npm run db:migrate --workspace @assistants-swarm-hub/core",
    "db:studio": "npm run db:studio --workspace @assistants-swarm-hub/core",
    "release:patch": "npm version patch --no-git-tag-version && npm run release:pin",
    "release:minor": "npm version minor --no-git-tag-version && npm run release:pin",
    "release:major": "npm version major --no-git-tag-version && npm run release:pin",
    "release:pin": "node scripts/pin-compose-version.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
