{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The four packages this SDK is assembled from are private and export raw
    // TypeScript. Mapping them to their sources puts them in this package's
    // own compilation, which is what lets the declaration build inline their
    // types instead of emitting `from "@assistants-swarm-hub/contracts"` into a
    // published .d.ts that resolves to nothing on the installer's machine.
    "paths": {
      "@assistants-swarm-hub/contracts": ["../contracts/src/index.ts"],
      "@assistants-swarm-hub/bus": ["../bus/src/index.ts"],
      "@assistants-swarm-hub/service": ["../service/src/index.ts"],
      "@assistants-swarm-hub/media": ["../media/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
