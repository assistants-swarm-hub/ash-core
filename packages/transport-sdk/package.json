{
  "name": "@assistants-swarm-hub/transport-sdk",
  "version": "5.0.0",
  "description": "What a transport package is written against: the interface a messaging platform is connected to an assistants-swarm-hub core through — the descriptor, adapter, normalizer and addressing rule the core hosts in its own process — plus the helpers a transport's own tools call.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "assistants-swarm-hub",
    "transport",
    "mcp",
    "chatbot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistants-swarm-hub/ash-core.git",
    "directory": "packages/transport-sdk"
  },
  "homepage": "https://github.com/assistants-swarm-hub/ash-core/blob/main/docs/development/adding-a-transport.md",
  "bugs": "https://github.com/assistants-swarm-hub/ash-core/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@assistants-swarm-hub/contracts": "*",
    "@assistants-swarm-hub/media": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
